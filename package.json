{
  "name": "osmcp",
  "version": "0.1.1",
  "description": "Serveur MCP pour pare-feu OPNsense : un outil par demande, lecture seule par défaut, rollback réel y compris sur 26.7+.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osmcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "catalog": "node scripts/build-catalog.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
